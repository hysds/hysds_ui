# Template only -- keep this file free of real credentials so it stays safe to
# share or commit. Put real values in local-proxy/proxy.env, which is excluded
# from git.
#
#   cp local-proxy/proxy.env.example local-proxy/proxy.env
#   # fill in, then:
#   set -a && source ./local-proxy/proxy.env && set +a
#
# Credentials must never reach src/config/ -- that directory is bundled into
# index_bundle.js and served to the browser.

# OpenSearch fine-grained-access-control user
export OS_USER=""
export OS_PASS=""

# Optional overrides
export OS_HOST="vpc-eaglevswir-proto-ylwe6yiuzvfjv5voxzmk57vxfy.us-west-2.es.amazonaws.com"
export PROXY_PORT="9200"
export PROXY_BIND="127.0.0.1"
